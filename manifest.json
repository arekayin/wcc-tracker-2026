{
  "manifest_version": 3,
  "name": "WCC 2026 Live: Gukesh vs Sindarov",
  "short_name": "WCC 2026",
  "version": "1.0.0",
  "description": "Minimal live tracker for the 2026 World Chess Championship. Board and moves from the Lichess broadcast, evaluation from Sesse.",
  "minimum_chrome_version": "102",
  "action": {
    "default_title": "Gukesh vs Sindarov",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://lichess.org/*",
    "https://analysis.sesse.net/*"
  ]
}
